import pandas as pd
import matplotlib.pyplot as plt

from google.colab import files
uploaded = files.upload()

df=pd.read_excel("projectdata.xlsx")
df

df = df.drop_duplicates()
df = df.dropna()
df.columns = df.columns.str.strip()

total_cost = df["Cost_USD"].sum()
print("Total Cloud Cost:", total_cost)

service_cost = df.groupby("Service_Type")["Cost_USD"].sum()
print(service_cost)

monthly_cost = df.groupby("Month")["Cost_USD"].sum()
print(monthly_cost)

print("\nTotal Cloud Cost:", total_cost)
print("\nCost by Service:")
print(service_cost)

print("\nMonthly Cost:")
print(monthly_cost)

plt.figure(figsize=(7,7))

service_cost.plot(
    kind="pie",
    autopct="%1.1f%%"
)

plt.title("Cloud Cost Distribution by Service Type")
plt.ylabel("")

plt.show()

df.to_excel("processed_cloud_cost_data.xlsx", index=False)
